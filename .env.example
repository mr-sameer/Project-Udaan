# ------------------------------------------------------------
# Supabase — required
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY= 
# Server-only. Never prefix with NEXT_PUBLIC_. Never commit a real value.
SUPABASE_SERVICE_ROLE_KEY= 
# ------------------------------------------------------------
# App
# ------------------------------------------------------------
# Used for auth redirect URLs, OpenGraph, and the sitemap.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------
# Payments
# ------------------------------------------------------------
# 'mock' for local development (see lib/payments/provider.ts).
# Set to 'razorpay' only once RAZORPAY_* below are filled in and
# the real adapter in lib/payments/provider.ts is implemented.
PAYMENTS_MODE=mock

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------
# Email (optional — not yet wired to any code path)
# ------------------------------------------------------------
EMAIL_PROVIDER=
EMAIL_API_KEY=
